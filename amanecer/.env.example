# ── Supabase (proyecto: proyectos_einAR) ────────────────────────────
SUPABASE_URL=https://nvdcwhoajvozxiwxhidp.supabase.co
# La service_role key: Supabase → Settings → API → service_role (secret).
# NUNCA va al navegador; sólo vive en el server (Vercel env vars).
SUPABASE_SERVICE_ROLE_KEY=

# ── Seguridad de la app ─────────────────────────────────────────────
# La clave con la que entrás vos desde el celular (elegí una frase).
APP_CLAVE=

# El token secreto que usa el Atajo de iOS para postear datos.
# Generá uno largo: openssl rand -hex 24
INGEST_TOKEN=

# ── Zona horaria para "hoy" y "anoche" ──────────────────────────────
TZ=America/Argentina/Cordoba
